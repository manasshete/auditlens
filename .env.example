# Gemma 4 via an OpenAI-compatible API (e.g. Jarvis AI). Check the provider docs for the exact values.
JARVIS_API_KEY=your_key_here
JARVIS_BASE_URL=https://your-jarvis-endpoint/v1
GEMMA_MODEL=gemma-4-31b
# Jarvis Labs example:
# JARVIS_BASE_URL=https://models.jarvislabs.net/v1
# GEMMA_MODEL=gemma-4-26b-a4b-it

# Gemma 4 "thinking" is OFF by default: with it on, the model often reasons until it runs
# out of tokens and never answers. Set to true to try it anyway.
# LLM_THINKING=false
# Max output tokens per request
# LLM_MAX_TOKENS=16384

# Local mode: run Gemma with Ollama so code never leaves the machine.
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_MODEL=gemma4
# OLLAMA_NUM_CTX=32768

# Max tokens of code + findings sent to the model
MAX_CONTEXT_TOKENS=100000

# Set to true to skip the LLM and build the report from Slither only (offline demo)
MOCK_LLM=false

# Optional: Etherscan fallback when auditing deployed contracts (Sourcify needs no key)
# ETHERSCAN_API_KEY=

# Optional: where reports are saved (default: ./reports)
# REPORTS_DIR=./reports
